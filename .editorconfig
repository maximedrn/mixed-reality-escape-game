root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
max_line_length = 80

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

dotnet_diagnostic.IDE0005.severity = warning

# Full explicit typing: no var, even when the type is obvious.
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error
dotnet_diagnostic.IDE0008.severity = error

# Prefer explicit object creation and require braced control-flow blocks.
csharp_style_implicit_object_creation_when_type_is_apparent = false:error
dotnet_diagnostic.IDE0090.severity = none
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# Preserve the repository's block-scoped namespace convention.
csharp_style_namespace_declarations = block_scoped:error

dotnet_diagnostic.IDE1006.severity = error

dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_pascal_case

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_style.i_pascal_case.required_prefix = I
dotnet_naming_style.i_pascal_case.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.severity = error
dotnet_naming_rule.types_are_pascal_case.symbols = named_types
dotnet_naming_rule.types_are_pascal_case.style = pascal_case

dotnet_naming_symbols.named_types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.named_types.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.members_are_pascal_case.severity = error
dotnet_naming_rule.members_are_pascal_case.symbols = members
dotnet_naming_rule.members_are_pascal_case.style = pascal_case

dotnet_naming_symbols.members.applicable_kinds = method, property, event
dotnet_naming_symbols.members.applicable_accessibilities = *

# More specific than the private-field rule: constants stay PascalCase.
dotnet_naming_rule.constants_are_pascal_case.severity = error
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.private_fields_use_underscore.severity = error
dotnet_naming_rule.private_fields_use_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_use_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# StyleCop.Analyzers: XML docs for public, internal and private declarations.
stylecop.documentation.documentExposedElements = true
stylecop.documentation.documentInternalElements = true
stylecop.documentation.documentPrivateElements = true
stylecop.documentation.documentPrivateFields = false

dotnet_diagnostic.SA1600.severity = error
dotnet_diagnostic.SA1602.severity = error
dotnet_diagnostic.SA1611.severity = error
dotnet_diagnostic.SA1612.severity = error
dotnet_diagnostic.SA1615.severity = error
dotnet_diagnostic.SA1618.severity = error
# File copyright headers are not mandated by this project.
dotnet_diagnostic.SA1633.severity = none
# CSharpier owns wrapping and spacing around parentheses.
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1111.severity = none
# The repository's naming rule requires an underscore on private fields.
dotnet_diagnostic.SA1309.severity = none

# SonarAnalyzer.CSharp: magic numbers, duplicate strings, nesting, complexity.
# S134's documented default maximum is 3 nested control-flow statements.
dotnet_diagnostic.S109.severity = error
dotnet_diagnostic.S1192.severity = error
dotnet_diagnostic.S134.severity = error
dotnet_diagnostic.S3776.severity = warning
dotnet_diagnostic.S107.severity = warning
dotnet_diagnostic.S1104.severity = error
dotnet_diagnostic.S1215.severity = error

# Public API design, resources, exceptions, disposal and argument checks.
dotnet_diagnostic.CA1050.severity = error
dotnet_diagnostic.CA1051.severity = error
dotnet_diagnostic.CA1031.severity = error
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA2201.severity = error
dotnet_diagnostic.CA2208.severity = error
dotnet_diagnostic.IDE0044.severity = warning

# Avoid accidental blocking and swallowing expected errors.
dotnet_diagnostic.S4462.severity = error
dotnet_diagnostic.S3168.severity = warning
dotnet_diagnostic.S2486.severity = error

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
