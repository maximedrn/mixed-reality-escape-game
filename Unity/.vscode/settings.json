{
    "files.exclude": {
        "{Library,library,Temp,temp,Obj,obj,Logs,logs,UserSettings,MemoryCaptures,Recordings}": true,
        "{Build,build,Builds,builds,UIElementsSchema,.utmp,.history}": true,
        "{.claude,.codex}": true,
        "Assets/{#Meta,_Recovery,Readme.asset}": true,
        "Assets/Resources/DevAgentSettings.asset": true,
        "**/{.DS_Store,Thumbs.db,.vs,.idea,.gradle,.gitkeep}": true,
        "**/*.{meta,csproj,sln,slnx,user,userprefs,suo,pidb,booproj,unityproj,log,apk,aab,obb}": true,
        "**/{mono_crash.*,sysinfo.txt,*_BackUpThisFolder_ButDontShipItWithYourGame,*_BurstDebugInformation_DoNotShip}": true
    },
    "files.watcherExclude": {
        "{Library,library,Temp,temp,Obj,obj,Logs,logs,UserSettings,MemoryCaptures,Recordings}/**": true,
        "{Build,build,Builds,builds,UIElementsSchema,.utmp,.history}/**": true,
        "Assets/{#Meta,_Recovery}/**": true,
        "**/{.vs,.idea,.gradle}/**": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
        "*.asmdef": "json",
        "*.asmref": "json"
    },
    "dotnet.defaultSolution": "Unity.slnx"
}
